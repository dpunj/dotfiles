[user]
	email = "dvx2492@gmail.com"
	name = "dpunj"

[core]
	editor = "zed --wait"
	pager = "delta"

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[alias]
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit

[branch]
	sort = -committerdate

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	line-numbers = true

[rerere]
	enabled = true

[fetch]
	prune = true
