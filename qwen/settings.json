{
  "model": {
    "name": "coder-model"
  },
  "auth": "oauth",
  "$version": 3,
  "security": {
    "auth": {
      "selectedType": "qwen-oauth"
    }
  },
  "context": {
    "fileName": [
      "QWEN.md",
      "AGENTS.md"
    ]
  },
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "tldraw": {
      "command": "bun",
      "args": [
        "run",
        "/Users/divesh/code/tldraw-mcp/src/index.ts"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}