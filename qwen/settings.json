{
  "model": {
    "name": "coder-model"
  },
  "auth": "oauth",
  "$version": 3,
  "security": {
    "auth": {
      "selectedType": "qwen-oauth"
    }
  },
  "context": {
    "fileName": ["QWEN.md", "AGENTS.md"]
  },
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.linear.app/sse"]
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "tldraw": {
      "command": "bun",
      "args": ["run", "/Users/divesh/code/tldraw-mcp/src/index.ts"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  }
}
